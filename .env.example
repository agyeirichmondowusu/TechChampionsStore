# Supabase project (Project Settings > API). Leave blank to run in demo mode (data saved in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override the Meet Champ AI endpoint. When blank and Supabase is set,
# the site calls the bundled edge function at <SUPABASE_URL>/functions/v1/champ-chat.
VITE_CHAMP_API_URL=

# Demo mode only (no Supabase): password for the built-in local admin account admin@techchampionstore.com
VITE_DEMO_ADMIN_PASSWORD=champion123

# Visitor analytics and emails need no extra variables here. They use Supabase edge functions
# (track-visit, send-email) whose keys are set with `supabase secrets set` - see README.
